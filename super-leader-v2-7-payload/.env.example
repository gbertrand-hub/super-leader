# Supabase project connection
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Local development value. In Vercel Production, use your stable production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Email feedback delivery through Resend
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=
FEEDBACK_FROM_NAME=Super Leader
RESEND_WEBHOOK_SECRET=

# Feedback queue and reminder processing
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> to the protected route.
CRON_SECRET=

# Twilio SMS delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Configure either a Messaging Service SID or a sender number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# WhatsApp Business Platform / Cloud API
# Use the Graph API version shown in your Meta developer dashboard, for example vXX.X.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_FEEDBACK_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE_FR=fr
WHATSAPP_TEMPLATE_LANGUAGE_EN=en_US
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Notifications operational emails (Resend)
# Falls back to FEEDBACK_FROM_EMAIL when NOTIFICATION_FROM_EMAIL is empty.
NOTIFICATION_FROM_EMAIL=notifications@ileadglobal.org
NOTIFICATION_FROM_NAME=Super Leader

# Temporary first-login access (optional overrides)
# Default expiry is 48 hours. Accepted range: 1 to 168 hours.
TEMPORARY_PASSWORD_EXPIRY_HOURS=48
# Falls back to NOTIFICATION_FROM_EMAIL / NOTIFICATION_FROM_NAME.
TEMPORARY_ACCESS_FROM_EMAIL=
TEMPORARY_ACCESS_FROM_NAME=Super Leader

# Super Leader platform workspace (controls demo and internal-access pipelines)
# Prefer the UUID in production. If omitted, the app falls back to the exact name "iLEAD Global".
SUPER_LEADER_PLATFORM_ORGANIZATION_ID=
SUPER_LEADER_PLATFORM_ORGANIZATION_NAME=iLEAD Global

# SUPER LEADER V2.5 - Abonnements
# test: attribution manuelle, factures de test, aucun debit bancaire reel.
SUPER_LEADER_BILLING_MODE=test
# Reserve pour la future integration du prestataire de paiement.
SUPER_LEADER_BILLING_PROVIDER=manual

# Zoom Server-to-Server OAuth (Super Leader V2.7)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
