# Supabase project connection
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# Local development value. In Vercel Production, use your stable production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Email feedback delivery through Resend
RESEND_API_KEY=
FEEDBACK_FROM_EMAIL=
FEEDBACK_FROM_NAME=Super Leader
RESEND_WEBHOOK_SECRET=

# Feedback queue and reminder processing
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> to the protected route.
CRON_SECRET=

# Twilio SMS delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Configure either a Messaging Service SID or a sender number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# WhatsApp Business Platform / Cloud API
# Use the Graph API version shown in your Meta developer dashboard, for example vXX.X.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_FEEDBACK_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE_FR=fr
WHATSAPP_TEMPLATE_LANGUAGE_EN=en_US
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
